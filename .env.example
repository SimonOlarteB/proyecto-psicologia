# Copiar a .env y completar. Nunca commitear .env.

NODE_ENV=production
APP_URL=https://tudominio.com

# Sesión admin (HMAC). Mínimo 32 caracteres aleatorios.
AUTH_SECRET=

# Cifrado de refresh tokens de Google. Si se omite, se usa AUTH_SECRET.
# TOKEN_ENCRYPTION_KEY=

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=psicologia
# SSL obligatorio hacia MySQL gestionado. Nunca DB_USER=root en producción.
DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# Ruta al PEM de la CA del proveedor (RDS, PlanetScale, etc.) si lo exige.
# DB_SSL_CA=/etc/ssl/certs/rds-ca-rsa2048-g1.pem
DB_CONNECTION_LIMIT=10

# Volumen persistente opcional. Por defecto: public/uploads
# UPLOAD_DIR=/var/lib/psicologia/uploads

WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=consultas@tudominio.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tudominio.com/api/google/callback

# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
